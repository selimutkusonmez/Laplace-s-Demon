QMainWindow, #central_widget, #central_widget::pane {
    background-color: #0F172A;
    color: #F8FAFC;
    border: none;
    font-family: "Segoe UI", sans-serif;
    font-size: 14px;
}
QWidget[class="ui"] {
    background-color: #0F172A;
}
QTabWidget::pane {
    border: 1px solid #334155;
    margin: 0px;
    padding: 0px;
    border-radius: 0px;
}
QTabWidget::tab-bar {
    alignment: left;
}
QTabBar::tab {
    background-color: #1E293B;
    color: #94A3B8;
    padding: 8px 20px;
    border: 1px solid #334155;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    margin-right: 2px;
    font-size: 14px;
}
QTabBar::tab:hover {
    background-color: #334155;
    color: #F8FAFC;
}
QTabBar::tab:selected {
    background-color: #3B82F6;
    color: #FFFFFF;
    border-color: #3B82F6;
}
QTabBar::tab:!selected {
    margin-top: 2px;
}
QListWidget[class="list"] {
    background-color: #1E293B;
    border: 1px solid #334155;
    border-radius: 4px;
    padding: 4px;
    font-size: 20px;
    outline: none;
}
QListWidget[class="list"]::item {
    padding: 8px 12px;
    border-radius: 3px;
    margin-bottom: 2px;
    color: #F8FAFC;
}
QListWidget[class="list"]::item:hover {
    background-color: #334155;
    color: #F8FAFC;
}
QListWidget[class="list"]::item:selected {
    background-color: #3B82F6;
    color: #FFFFFF;
}
QStatusBar {
    background-color: #0F172A;
    color: #64748B;
    border: none;
    border-top: 1px solid #334155;
    padding-left: 8px;
    font-size: 12px;
}
QStatusBar::item {
    border: none;
}
QToolButton {
    color: #F8FAFC;
    background-color: transparent;
    border: none;
    padding: 6px 12px;
    font-size: 14px;
    border-radius: 4px;
}
QToolButton:hover {
    background-color: #334155;
}
QToolButton:pressed {
    background-color: #1E293B;
}
QToolButton::menu-indicator {
    image: none;
    width: 0px;
}
QMenuBar {
    color: #F8FAFC;
    background-color: transparent;
    border: none;
    border-bottom: 1px solid #334155;
    padding: 1px;
    font-size: 12px;
}
QMenuBar::item {
    background-color: transparent;
    padding: 6px 12px;
    border-radius: 4px;
}
QMenuBar::item:selected {
    background-color: #334155;
}
QMenu {
    background-color: #1E293B;
    color: #F8FAFC;
    border: 1px solid #334155;
    border-radius: 4px;
    padding: 4px;
    font-size: 14px;
}
QMenu::item {
    padding: 6px 24px 6px 12px;
    border-radius: 3px;
}
QMenu::item:selected {
    background-color: #3B82F6;
    color: #FFFFFF;
}
QMenu::separator {
    height: 1px;
    background: #334155;
    margin: 5px 10px;
}
QGroupBox {
    border: 1px solid #334155;
    border-radius: 0px;
    margin-top: 12px;
    padding-top: 12px;
    background-color: #0F172A;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 6px;
    color: #94A3B8;
    font-weight: bold;
    font-size: 14px;
}
QLabel {
    font-size: 14px;
    color: #F8FAFC;
}
QLineEdit, QTextEdit {
    background-color: #1E293B;
    border: 1px solid #334155;
    border-radius: 4px;
    padding: 8px;
    color: #F8FAFC;
    font-size: 14px;
}
QLineEdit:focus, QTextEdit:focus {
    border: 1px solid #3B82F6;
}
QTextEdit[readOnly="true"] {
    background-color: #0F172A;
    color: #94A3B8;
}
QPushButton {
    background-color: #3B82F6;
    color: #FFFFFF;
    border: none;
    border-radius: 4px;
    padding: 8px 16px;
    font-weight: bold;
    font-size: 14px;
}
QPushButton:hover {
    background-color: #60A5FA;
}
QPushButton:pressed {
    background-color: #2563EB;
}
QTableView {
    background-color: #0F172A;
    color: #F8FAFC;
    border: 1px solid #334155;
    gridline-color: #334155;
    border-radius: 0px;
}
QHeaderView {
    background-color: #0F172A;
    border: none;
}
QHeaderView::section {
    background-color: #1E293B;
    color: #94A3B8;
    padding: 6px;
    border: 1px solid #334155;
    font-size: 14px;
    font-weight: bold;
    border-radius: 0px;
}
QTableCornerButton::section {
    background-color: #1E293B;
    border: 1px solid #334155;
}
QComboBox {
    background-color: #1E293B;
    color: #F8FAFC;
    border: 1px solid #334155;
    border-radius: 4px;
    padding: 6px;
    font-size: 14px;
}
#operation_name {
    color: #F8FAFC;
    font-size: 24px;
    font-weight: bold;
}
QMessageBox {
    background-color: #0F172A;
    font-size: 14px;
}
QGroupBox[class=bottom_groupbox] {
    border: none;
    background-color: transparent;
    margin-top: 0px;
    padding-top: 0px;
}
QCheckBox {
    color: #F8FAFC;
    font-size: 14px;
    spacing: 8px;
}
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    background-color: #1E293B;
    border: 1px solid #334155;
    border-radius: 3px;
}
QCheckBox::indicator:hover {
    border: 1px solid #3B82F6;
}
QCheckBox::indicator:checked {
    background-color: #3B82F6;
    border: 1px solid #3B82F6;
}